{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    }
  ],
  "build": {
    "env": {
      "VITE_SUPABASE_URL": "https://vciticnsuxqwlalumgyr.supabase.co",
      "VITE_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZjaXRpY25zdXhxd2xhbHVtZ3lyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODA2ODYyNTMsImV4cCI6MjA5NjI2MjI1M30.58M4rcu8mTTHWxO7C9qKbhkvN9w6ZbtHlE0kXrGJGtM"
    }
  }
}
